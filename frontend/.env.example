# Frontend configuration template.
#
# Copy to `.env` and fill in real values for local development:
#   cp .env.example .env
#
# This is read at BUILD time by Vite, not at runtime, so a deployed value has to
# be present in the build environment of the hosting platform.

# Base URL of the backend API.
#
#   local dev:      http://localhost:3000
#   same origin:    leave EMPTY
#
# In a production build an unset or empty value means "same origin", which is
# correct when the backend serves this app. Setting it to a localhost address in
# a production build makes the app call the visitor's own machine, so that is
# reported as a configuration error in the browser console.
VITE_API_BASE_URL=http://localhost:3000
