# Backend configuration template.
#
# Copy to `.env` and fill in real values for local development:
#   cp .env.example .env
#
# `.env` is gitignored and must never be committed. In a deployed environment the
# values below are set as service variables in the hosting dashboard instead, and
# configuration is validated once at startup: a missing required value or an
# unrecognised value fails the boot with an explanatory message rather than
# failing later on a request.

# --- Required ---------------------------------------------------------------

# Prisma connection string.
#   local SQLite:  file:./dev.db
#   deployed:      postgresql://user:password@host:5432/ops   (hosting injects this)
DATABASE_URL=file:./dev.db

# --- Optional, with defaults -----------------------------------------------

# HTTP port. Defaults to 3000. Injected automatically by most hosting platforms.
# PORT=3000

# Which request-assistance provider to use: `local` or `gemini`.
# `local` is deterministic and makes no external calls; it is the default and is
# what the automated AI evaluation suite runs against.
# A misspelled value now fails startup instead of silently behaving as `local`.
# AI_PROVIDER=local

# Gemini API key. Only needed when AI_PROVIDER=gemini. When absent, assistance
# falls back to the deterministic local provider and the app logs a warning.
# GEMINI_API_KEY=

# Gemini model id. Defaults to gemini-3.5-flash-lite.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Exact CORS allow-list, comma separated, each an absolute http(s) URL.
# When unset it defaults to the two Vite dev origins. When set it REPLACES them,
# so a deployed instance only allows the origin it was told about.
# Frontend and backend served from the same origin? Leave this unset.
# FRONTEND_ORIGIN=https://ops.example.com
