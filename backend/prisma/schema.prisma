generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model RequestType {
  id                  String                @id
  name                String
  department          String
  schema              Json
  routingMode         String                @default("approval")
  destinationQueue    String                @default("General")
  approvalChain       Json                  @default("[]")
  currentVersion      Int                   @default(1)
  requests            Request[]
  workflowVersions    RequestTypeVersion[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([department])
}

model RequestTypeVersion {
  id               String     @id
  requestTypeId    String
  version          Int
  name             String
  department       String
  schema           Json
  routingMode      String
  destinationQueue String
  approvalChain    Json
  publishedBy      String
  publishedAt      DateTime   @default(now())
  requestType      RequestType @relation(fields: [requestTypeId], references: [id], onDelete: Cascade)

  @@unique([requestTypeId, version])
  @@index([requestTypeId, publishedAt])
}

model Request {
  id                  String              @id
  requesterId         String
  requestTypeId       String
  description         String
  formData            Json
  status              String              @default("Submitted")
  idempotencyKey      String?             @unique
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  requestType         RequestType         @relation(fields: [requestTypeId], references: [id])
  attachments         Attachment[]
  statusEvents        StatusEvent[]
  queueAssignment     QueueAssignment?
  fulfillmentComments FulfillmentComment[]

  @@index([requesterId])
}

model QueueAssignment {
  id                  String   @id
  requestId           String   @unique
  queue               String
  assignedFulfillerId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  request             Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([queue])
}

model FulfillmentComment {
  id         String   @id
  requestId  String
  authorId   String
  body       String
  visibility String   @default("internal")
  createdAt  DateTime @default(now())
  request    Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

model Attachment {
  id               String   @id
  requestId        String
  filename         String
  size             Int
  contentType      String
  storageReference String
  request          Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model StatusEvent {
  id          String   @id
  requestId   String
  status      String
  source      String
  createdAt   DateTime @default(now())
  request     Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

model Notification {
  id          String    @id
  recipientId String
  type        String
  title       String
  message     String
  requestId   String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([recipientId, readAt, createdAt])
}

